<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<SplitPane fx:id="workspaceSplitPane" dividerPositions="0.23" styleClass="workspace"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mcworldexplorer.ui.MainController">
    <items>
        <VBox fx:id="worldSidebar" minWidth="180.0" prefWidth="240.0" maxWidth="340.0"
              styleClass="world-sidebar" SplitPane.resizableWithParent="false">
            <children>
                <VBox spacing="12.0" styleClass="sidebar-header">
                    <Label text="我的世界" styleClass="section-title"/>
                    <Button fx:id="chooseFolderButton" mnemonicParsing="false"
                            onAction="#handleChooseFolder" text="%button.chooseFolder" maxWidth="Infinity"/>
                </VBox>
                <TreeView fx:id="worldTreeView" minWidth="0.0" VBox.vgrow="ALWAYS"/>
                <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="sidebar-status">
                    <ProgressIndicator fx:id="scanProgressIndicator" managed="false" visible="false"
                                       minWidth="18.0" maxWidth="18.0" prefWidth="18.0"
                                       minHeight="18.0" maxHeight="18.0" prefHeight="18.0"/>
                    <Label fx:id="scanStatusLabel" text="" wrapText="true" minWidth="0.0"
                           styleClass="muted-text" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label text="存档只读 · 运行数据独立保存" wrapText="true" styleClass="sidebar-footnote"/>
            </children>
        </VBox>
        <VBox minWidth="440.0" styleClass="world-workspace">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="world-header">
                    <Button fx:id="sidebarToggleButton" text="世界列表" mnemonicParsing="false" minWidth="-Infinity"
                            onAction="#handleToggleSidebar" styleClass="quiet-button">
                        <tooltip><Tooltip text="展开或收起世界列表"/></tooltip>
                    </Button>
                    <VBox spacing="3.0" minWidth="0.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="worldNameLabel" text="选择一个世界" minWidth="0.0"
                               maxWidth="Infinity" styleClass="world-name"/>
                        <Label fx:id="worldSummaryLabel" text="无需启动 Minecraft，即可浏览已有世界"
                               minWidth="0.0" maxWidth="Infinity" styleClass="muted-text"/>
                    </VBox>
                    <ToggleButton fx:id="detailsToggleButton" text="存档详情" mnemonicParsing="false" minWidth="-Infinity" styleClass="quiet-button"/>
                </HBox>
                <StackPane VBox.vgrow="ALWAYS" minHeight="0.0">
                    <children>
                        <fx:include fx:id="mapViewer" source="map-view.fxml"/>
                        <ScrollPane fx:id="detailsPane" visible="false" managed="false"
                                    prefWidth="280.0" maxWidth="280.0" minWidth="0.0"
                                    fitToWidth="true" hbarPolicy="NEVER"
                                    styleClass="details-panel" StackPane.alignment="TOP_RIGHT">
                            <content>
                                <VBox spacing="14.0" fillWidth="true">
                                    <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="存档信息" styleClass="section-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                        <Button text="收起" mnemonicParsing="false" onAction="#handleCloseDetails" styleClass="quiet-button"/>
                                    </HBox>
                                    <Separator/>
                                    <VBox spacing="4.0"><Label text="Minecraft 版本" styleClass="detail-label"/><Label fx:id="versionLabel" text="-" wrapText="true" styleClass="detail-value"/></VBox>
                                    <VBox spacing="4.0"><Label text="游戏模式" styleClass="detail-label"/><Label fx:id="gameModeLabel" text="-" wrapText="true" styleClass="detail-value"/></VBox>
                                    <VBox spacing="4.0"><Label text="目录创建时间" styleClass="detail-label"/><Label fx:id="folderCreationTimeLabel" text="-" wrapText="true" styleClass="detail-value"/></VBox>
                                    <VBox spacing="4.0"><Label text="最后游玩" styleClass="detail-label"/><Label fx:id="lastPlayedLabel" text="-" wrapText="true" styleClass="detail-value"/></VBox>
                                    <VBox spacing="4.0"><Label text="游戏时长" styleClass="detail-label"/><Label fx:id="gameTimeLabel" text="-" wrapText="true" styleClass="detail-value"/></VBox>
                                    <VBox spacing="4.0"><Label text="世界种子" styleClass="detail-label"/><Label fx:id="seedLabel" text="-" wrapText="true" styleClass="detail-value"/></VBox>
                                    <VBox spacing="4.0"><Label text="世界出生点" styleClass="detail-label"/><Label fx:id="spawnPosLabel" text="-" wrapText="true" styleClass="detail-value"/></VBox>
                                    <VBox spacing="4.0"><Label text="玩家位置" styleClass="detail-label"/><Label fx:id="playerPosLabel" text="-" wrapText="true" styleClass="detail-value"/></VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </StackPane>
            </children>
        </VBox>
    </items>
</SplitPane>
