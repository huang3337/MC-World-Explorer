<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mcworldexplorer.ui.MapViewerController" minWidth="0.0" minHeight="0.0">
    <children>
        <FlowPane hgap="8.0" vgap="8.0" alignment="CENTER_LEFT" styleClass="map-toolbar">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="7.0">
                    <Label text="维度" styleClass="muted-text"/>
                    <ComboBox fx:id="dimensionComboBox" disable="true" prefWidth="160.0" minWidth="100.0"/>
                </HBox>
                <MenuButton fx:id="locateMenuButton" text="定位" mnemonicParsing="false">
                    <items>
                        <MenuItem text="查看已保存范围…" onAction="#handleSavedRange"/>
                        <SeparatorMenuItem/>
                        <CustomMenuItem hideOnClick="false">
                            <content>
                                <VBox spacing="10.0" prefWidth="250.0" styleClass="popover-content">
                                    <Label text="定位到坐标" styleClass="section-title"/>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <Label text="X"/><TextField fx:id="xField" onAction="#handleLocate" prefColumnCount="7" promptText="0" HBox.hgrow="ALWAYS"/>
                                        <Label text="Z"/><TextField fx:id="zField" onAction="#handleLocate" prefColumnCount="7" promptText="0" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <Label fx:id="coordinateErrorLabel" styleClass="field-error" text="" wrapText="true"/>
                                    <Button text="前往坐标" mnemonicParsing="false" onAction="#handleLocate" maxWidth="Infinity"/>
                                </VBox>
                            </content>
                        </CustomMenuItem>
                    </items>
                </MenuButton>
                <MenuButton fx:id="playerListButton" disable="true" mnemonicParsing="false" text="玩家列表"/>
                <ToggleButton fx:id="viewerModeButton" disable="true" mnemonicParsing="false"
                              onAction="#handleViewerMode" text="三维选区" styleClass="mode-switch"/>
                <Button fx:id="resourceSettingsButton" text="资源与插件…" mnemonicParsing="false" onAction="#handleResourceSettings"/>
                <MenuButton fx:id="moreMenuButton" text="工具" mnemonicParsing="false">
                    <items>
                        <CustomMenuItem hideOnClick="false">
                            <content>
                                <VBox spacing="8.0" prefWidth="245.0" styleClass="popover-content">
                                    <Label text="导出地图" styleClass="section-title"/>
                                    <Button fx:id="exportButton" disable="true" mnemonicParsing="false"
                                            onAction="#handleExport" text="导出当前视口 PNG" maxWidth="Infinity"/>
                                    <Separator/>
                                    <Label text="缓存维护" styleClass="section-title"/>
                                    <Button fx:id="clearCacheButton" disable="true" mnemonicParsing="false"
                                            onAction="#handleClearCache" text="清理存档缓存并重新加载" maxWidth="Infinity"/>
                                    <Label text="只清理程序缓存，不修改原存档。" wrapText="true" styleClass="muted-text"/>
                                </VBox>
                            </content>
                        </CustomMenuItem>
                    </items>
                </MenuButton>
            </children>
        </FlowPane>
        <VBox fx:id="viewerSelectionBar" managed="false" visible="false" spacing="8.0" styleClass="viewer-selection-bar">
            <FlowPane alignment="CENTER_LEFT" hgap="8.0" vgap="6.0">
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label text="选区范围" styleClass="muted-text"/>
                    <ComboBox fx:id="viewerRangeComboBox" prefWidth="112.0"/>
                </HBox>
                <Button fx:id="viewerConfirmButton" disable="true" mnemonicParsing="false"
                        onAction="#handleViewerConfirm" text="生成三维预览" styleClass="primary-action"/>
                <Button fx:id="viewerCancelButton" managed="false" visible="false"
                        mnemonicParsing="false" onAction="#handleViewerCancel" text="取消生成"/>
            </FlowPane>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label fx:id="viewerSelectionLabel" text="在地图上点击以锁定三维区域" wrapText="true"
                       minWidth="0.0" minHeight="0.0" maxHeight="40.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="muted-text"/>
                <ProgressBar fx:id="viewerProgressBar" managed="false" visible="false" prefWidth="110.0" progress="-1.0"/>
            </HBox>
            <TitledPane fx:id="viewerAdvancedOptions" text="性能与资源" expanded="false" animated="false" styleClass="preview-options">
                <content>
                    <FlowPane alignment="CENTER_LEFT" hgap="12.0" vgap="8.0">
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Label text="性能档位" styleClass="muted-text"/>
                            <ComboBox fx:id="viewerProfileComboBox" prefWidth="92.0"/>
                        </HBox>
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <MenuButton fx:id="viewerTextureMenu" text="纹理：自动" mnemonicParsing="false">
                        <items>
                            <MenuItem text="手动选择 JAR" onAction="#handleViewerTexture"/>
                            <MenuItem text="自动匹配资源" onAction="#handleViewerAutomaticTexture"/>
                            <MenuItem text="手动选择游戏目录…" onAction="#handleViewerResourceInstance"/>
                            <MenuItem text="使用简化颜色" onAction="#handleViewerSimpleColors"/>
                        </items>
                    </MenuButton>
                    <Label fx:id="viewerTextureHelp" text="?" styleClass="viewer-texture-help"
                           accessibleText="纹理选择帮助">
                        <tooltip>
                            <Tooltip wrapText="true" maxWidth="360.0" styleClass="viewer-texture-tooltip"
                                     text="默认按存档版本尝试加载本机原版资源，并从所属游戏目录读取 Mod 和已启用资源包。选择“自动匹配资源”可清除该存档的手动 JAR 和游戏目录绑定，重新自动查找。&#10;&#10;未找到时，选择“手动选择 JAR”，指向与存档版本对应的 Minecraft Java 客户端 JAR。&#10;&#10;常见位置（以 1.21.1 为例）：游戏目录下的&#10;.minecraft\versions\1.21.1\1.21.1.jar&#10;部分启动器的游戏目录直接包含 versions 文件夹。&#10;&#10;“手动选择 JAR”请选择原版客户端，不要选择 Mod 或服务端。&#10;&#10;Mod 未自动匹配时，使用“手动选择游戏目录”，指向包含 mods、resourcepacks 或 saves 的游戏目录，不是某个 Mod JAR。可在旁边的“资源诊断”查看来源与降级原因。按存档版本尝试加载；未兼容的方块会降级。没有对应资源时，可选择“使用简化颜色”。"/>
                        </tooltip>
                    </Label>
                    <Button fx:id="viewerResourceDiagnosticsButton" text="查看解析诊断" mnemonicParsing="false"
                            onAction="#handleViewerResourceDiagnostics" disable="${viewerTextureMenu.disable}">
                        <tooltip><Tooltip text="按 Mod 查看最近选区的解析问题与插件开发线索。"/></tooltip>
                    </Button>
                </HBox>
                    </FlowPane>
                </content>
            </TitledPane>
        </VBox>
        <StackPane VBox.vgrow="ALWAYS" minHeight="160.0" styleClass="map-surface">
            <children>
                <StackPane fx:id="viewportHost" minHeight="0.0" minWidth="0.0" styleClass="map-viewport"/>
                <ToggleButton fx:id="viewerAreasButton" text="已加载区域 · 0" mnemonicParsing="false"
                              onAction="#handleViewerAreas" StackPane.alignment="TOP_RIGHT" styleClass="map-overlay-control">
                    <StackPane.margin><Insets top="12.0" right="16.0"/></StackPane.margin>
                </ToggleButton>
                <StackPane fx:id="viewerAreasHost" managed="false" visible="false" minWidth="0.0"
                           maxWidth="256.0" maxHeight="-Infinity" StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin><Insets top="54.0" right="16.0" bottom="16.0"/></StackPane.margin>
                </StackPane>
                <MenuButton fx:id="layersMenuButton" text="图层与标记" mnemonicParsing="false"
                            StackPane.alignment="BOTTOM_LEFT" styleClass="map-overlay-control">
                    <StackPane.margin><Insets bottom="16.0" left="16.0"/></StackPane.margin>
                    <items>
                        <CustomMenuItem hideOnClick="false">
                            <content>
                                <VBox spacing="12.0" prefWidth="280.0" styleClass="popover-content">
                                    <Label text="图层" styleClass="section-title"/>
                                    <ToggleButton fx:id="surfaceOverviewButton" disable="true" mnemonicParsing="false"
                                                  onAction="#handleSurfaceOverview" text="地表总览" maxWidth="Infinity"/>
                                    <Label text="洞穴高度 · 拖动选择高度带" styleClass="muted-text"/>
                                    <Label fx:id="layerRangeLabel" text="-" wrapText="true"/>
                                    <Slider fx:id="layerHeightSlider" blockIncrement="1.0" disable="true"
                                            majorTickUnit="32.0" minWidth="130.0" showTickMarks="true"/>
                                    <Separator/>
                                    <Label text="地图标记" styleClass="section-title"/>
                                    <FlowPane hgap="7.0" vgap="7.0">
                                        <ToggleButton fx:id="playerMarkerButton" selected="true" text="玩家"/>
                                        <ToggleButton fx:id="spawnMarkerButton" selected="true" text="出生点"/>
                                        <ToggleButton fx:id="portalMarkerButton" selected="true" text="传送门"/>
                                    </FlowPane>
                                    <Label text="传送门仅显示已加载区块内的结果。" wrapText="true" styleClass="muted-text"/>
                                </VBox>
                            </content>
                        </CustomMenuItem>
                    </items>
                </MenuButton>
                <VBox fx:id="mapZoomControls" alignment="BOTTOM_RIGHT" spacing="5.0" maxWidth="80.0" maxHeight="-Infinity" StackPane.alignment="BOTTOM_RIGHT">
                    <StackPane.margin><Insets bottom="16.0" right="16.0"/></StackPane.margin>
                    <Button text="＋" mnemonicParsing="false" onAction="#handleZoomIn" maxWidth="Infinity" accessibleText="放大地图" styleClass="map-overlay-control"/>
                    <Button text="−" mnemonicParsing="false" onAction="#handleZoomOut" maxWidth="Infinity" accessibleText="缩小地图" styleClass="map-overlay-control"/>
                    <Button text="重置" mnemonicParsing="false" onAction="#handleReset" maxWidth="Infinity" styleClass="map-overlay-control"/>
                </VBox>
            </children>
        </StackPane>
        <Label fx:id="statusLabel" text="选择存档后浏览地图" wrapText="true" minHeight="0.0"
               maxHeight="48.0" maxWidth="Infinity" styleClass="map-status"/>
    </children>
</VBox>
